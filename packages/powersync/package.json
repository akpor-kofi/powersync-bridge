{
  "name": "@powersync-bridge/powersync",
  "version": "0.0.1-alpha.0",
  "description": "PowerSync driver for powersync-bridge: differentialWatch, upload-queue mirror, presence probes, sync streams and status, on top of @powersync/common.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akpor-kofi/powersync-bridge.git",
    "directory": "packages/powersync"
  },
  "homepage": "https://github.com/akpor-kofi/powersync-bridge#readme",
  "bugs": {
    "url": "https://github.com/akpor-kofi/powersync-bridge/issues"
  },
  "keywords": [
    "powersync",
    "offline-first",
    "local-first",
    "sqlite",
    "sync"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@powersync/common": ">=2.3.0",
    "powersync-bridge": "workspace:*"
  },
  "devDependencies": {
    "@powersync/common": "^2.3.0",
    "powersync-bridge": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0"
  }
}
