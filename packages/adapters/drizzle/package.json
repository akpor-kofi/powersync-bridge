{
  "name": "@powersync-bridge/drizzle",
  "version": "0.0.1-alpha.0",
  "description": "Drizzle adapter for powersync-bridge: executes builders through the ORM so rows arrive decoded, derives watched tables, and hands the SDK a compilable query.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akpor-kofi/powersync-bridge.git",
    "directory": "packages/adapters/drizzle"
  },
  "homepage": "https://github.com/akpor-kofi/powersync-bridge#readme",
  "bugs": {
    "url": "https://github.com/akpor-kofi/powersync-bridge/issues"
  },
  "keywords": [
    "powersync",
    "offline-first",
    "local-first",
    "sqlite",
    "sync",
    "drizzle",
    "orm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@powersync/drizzle-driver": ">=0.8.0",
    "drizzle-orm": ">=0.36.0",
    "powersync-bridge": "workspace:*"
  },
  "devDependencies": {
    "@powersync/drizzle-driver": "^0.8.0",
    "drizzle-orm": "^0.45.3",
    "powersync-bridge": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0"
  }
}
