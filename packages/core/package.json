{
  "name": "powersync-bridge",
  "version": "0.0.1-alpha.0",
  "description": "Client-side bridge between a PowerSync local SQLite database and a conventional HTTP API: raced first paint, pending-write-aware reconcile, bounded partition escalation.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akpor-kofi/powersync-bridge.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/akpor-kofi/powersync-bridge#readme",
  "bugs": {
    "url": "https://github.com/akpor-kofi/powersync-bridge/issues"
  },
  "keywords": [
    "powersync",
    "offline-first",
    "local-first",
    "sqlite",
    "sync"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.0"
  }
}
