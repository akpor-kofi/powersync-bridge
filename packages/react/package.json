{
  "name": "@powersync-bridge/react",
  "version": "0.0.1-alpha.0",
  "description": "React bindings for powersync-bridge: BridgeProvider, useRacedList, useInfiniteList, useOnDemandStream, useAutoSync (useSyncExternalStore-based).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akpor-kofi/powersync-bridge.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/akpor-kofi/powersync-bridge#readme",
  "bugs": {
    "url": "https://github.com/akpor-kofi/powersync-bridge/issues"
  },
  "keywords": [
    "powersync",
    "offline-first",
    "local-first",
    "sqlite",
    "sync",
    "react",
    "hooks"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "powersync-bridge": "workspace:*",
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "powersync-bridge": "workspace:*",
    "react": "^19.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0"
  }
}
