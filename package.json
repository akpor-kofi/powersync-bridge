{
  "name": "powersync-bridge-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --filter './packages/**' typecheck",
    "clean": "pnpm -r --filter './packages/**' exec rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
